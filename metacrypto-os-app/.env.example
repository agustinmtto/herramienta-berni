# MetaCrypto OS — variables de la aplicación.
# Copia a apps/inbox/.env.local y pídele los valores al operador.
# NO uses las de producción: se te dará un Supabase de desarrollo.

# ── Base de datos ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 🔴 service_role SALTA la seguridad por filas (RLS). La app habla con
# PostgREST con esta clave, así que en desarrollo tiene que ser la de un
# proyecto de desarrollo, nunca la de producción.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sesión del OS ── secreto con el que se firma la cookie. Cualquier cadena larga vale en local.
AUTH_TOKEN=

# ── Portal público del cliente ── base de los enlaces /c/<token> y /e/<token>
PORTAL_BASE_URL=http://localhost:3000

# ── La firma del contrato ──
# Vacío en desarrollo: el PDF se genera igual, con un trazo de relleno.
# Ver apps/inbox/lib/contratos/firma.ts
CONTRATO_FIRMA_PNG_BASE64=

# ── Integraciones (opcionales en local; sin ellas esas pantallas no cargan) ──
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_API_BASE=https://services.leadconnectorhq.com
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
CRON_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

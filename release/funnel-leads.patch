@@ -0,0 +1,57 @@
+name: Quiz leads integration
+
+on:
+  pull_request:
+    paths:
+      - "apps/inbox/**"
+      - "supabase/migrations/**"
+      - "supabase/seed.sql"
+      - ".github/workflows/quiz-leads-integration.yml"
+  workflow_dispatch:
+
+jobs:
+  quiz-leads:
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+          cache-dependency-path: apps/inbox/package-lock.json
+      - uses: supabase/setup-cli@v1
+        with:
+          version: 2.118.0
+      - name: Install Inbox dependencies
+        working-directory: apps/inbox
+        run: npm ci
+      - name: Start local Supabase and apply migrations
+        run: |
+          supabase start
+          supabase db reset
+          supabase status -o env > /tmp/supabase.env
+          source /tmp/supabase.env
+          echo "SUPABASE_URL=$API_URL" >> "$GITHUB_ENV"
+          echo "SUPABASE_ANON_KEY=$ANON_KEY" >> "$GITHUB_ENV"
+          echo "SUPABASE_SERVICE_ROLE_KEY=$SERVICE_ROLE_KEY" >> "$GITHUB_ENV"
+      - name: Run required database suites with zero skips
+        working-directory: apps/inbox
+        env:
+          LEAD_TESTS_REQUIRE_DB: "1"
+        run: |
+          npx --no-install vitest run lib/__tests__/quiz-leads-rpc.test.ts --reporter=json --outputFile=/tmp/quiz-leads-integration.json
+          node -e "const r=require('/tmp/quiz-leads-integration.json'); if(r.numPendingTests || r.numTodoTests) process.exit(1)"
+      - name: Run complete Inbox suite with zero skips
+        working-directory: apps/inbox
+        env:
+          LEAD_TESTS_REQUIRE_DB: "1"
+        run: |
+          npx --no-install vitest run --reporter=json --outputFile=/tmp/inbox-tests.json
+          node -e "const r=require('/tmp/inbox-tests.json'); if(r.numPendingTests || r.numTodoTests) process.exit(1)"
+      - name: Run Inbox static and build gates
+        working-directory: apps/inbox
+        run: |
+          npm run typecheck
+          npm run lint
+          npm run build
diff --git a/apps/inbox/app/(os)/leads/[id]/page.tsx b/apps/inbox/app/(os)/leads/[id]/page.tsx

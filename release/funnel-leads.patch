+  .quiz-page .preview-card { top: 24px; width: 280px; height: 225px; padding: 22px; }
+  .quiz-page .hero-action { padding: 26px 28px; }
+  .quiz-page .hero-action p { font-size: 0.9rem; }
+  .quiz-page .wizard-section { padding: 5vh 24px 10vh; gap: 22px; }
+  .quiz-page .question-card { padding: 34px 32px; }
+  .quiz-page .opt { padding: 16px 20px; font-size: 0.98rem; }
+  .quiz-page .allocation-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+
+@keyframes rise {
+  from { opacity: 0; transform: translateY(22px); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+@keyframes question-in {
+  from { opacity: 0; transform: translateY(14px) scale(0.992); }
+  to { opacity: 1; transform: translateY(0) scale(1); }
+}
+
+@keyframes confirm-pulse {
+  0% { transform: scale(1); }
+  55% { transform: scale(0.994); border-color: var(--gold-line); }
+  100% { transform: scale(1); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  * { animation: none !important; transition: none !important; }
+}
